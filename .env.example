# ==============================================================================
# Vision-Pulse — Environment Configuration
# ==============================================================================
# Renamed this file to `.env` and fill in the values below.

#Deployment Server
APP_ENV=PRODUCION

# ------------------------------------------------------------------------------
# API Keys (External Services)
# ------------------------------------------------------------------------------
# Google Gemini (Primary Image Generation - gemini-2.5-flash-image)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (Image Prompts, Subtitles, Image Fallback, TTS Fallback)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs (Primary Text-to-Speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ------------------------------------------------------------------------------
# Database & Worker Infrastructure
# ------------------------------------------------------------------------------
# PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/vision_pulse
DATABASE_URL=postgresql://user:password@localhost:5432/vision_pulse

# Redis connection string for Celery Broker
# Example: redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Redis connection string for Celery Result Backend
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Secret key for JWT Token Generation (generate using: openssl rand -hex 32)
SECRET_KEY=your_super_secret_key_here

# JWT Token Expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth Client ID (for checking Google ID Tokens)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Email Configuration (SMTP)
# ------------------------------------------------------------------------------
# Default is set for Gmail. For Gmail, use an "App Password" rather than your real password.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=Vision-Pulse <noreply@visionpulse.com>

# ------------------------------------------------------------------------------
# Application configuration
# ------------------------------------------------------------------------------
# Video configuration overrrides (matches VIDEO_GENERATION.md defaults)
DEFAULT_FPS=30
ENABLE_SUBTITLES=True
SUBTITLE_MODEL=gpt-4o-mini
CAMERA_ZOOM_INTENSITY=0.15
CAMERA_ENABLE_ROTATION=False
CAMERA_PAN_HORIZONTAL_MAX=0.08
CAMERA_PAN_VERTICAL_MAX=0.04
IMAGE_COUNT=7
MAX_SCRIPT_LENGTH=1500

# Job Queue limits
MAX_CONCURRENT_JOBS=10
MAX_QUEUED_JOBS=10
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=60

# ------------------------------------------------------------------------------
# Stripe Payment Integration
# ------------------------------------------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Get webhook secret by running: stripe listen --forward-to localhost:8000/api/v1/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Frontend redirect URLs after Stripe Checkout
STRIPE_SUCCESS_URL=http://localhost:3000/subscription/success
STRIPE_CANCEL_URL=http://localhost:3000/subscription/cancel

# ------------------------------------------------------------------------------
# Cloudinary Configuration
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
